# Copy to .env and edit (cp .env.example .env). Never commit the real .env.

# ---- required for any real deployment ----
ADMIN_EMAIL=admin@floodalert.lk
ADMIN_PASSWORD=change-this-long-password
# Long random string. If left empty a key is generated and stored in backend/.secret_key
SECRET_KEY=
# Used by docker-compose for the PostgreSQL container
DB_PASSWORD=change-this-too

# ---- behaviour ----
REFRESH_MINUTES=30
# 1 = always use mock rainfall (demos without internet)
FLOODALERT_OFFLINE=0
# 1 = average the ML probability into the risk score
USE_ML_BLEND=0
AUTO_VERIFY_THRESHOLD=3
REPORTS_PER_HOUR=5
MAX_UPLOAD_MB=5

# ---- notifications (all optional; without them alerts are only logged) ----
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@floodalert.lk
# Path to a Firebase service-account json (also: pip install firebase-admin)
GOOGLE_APPLICATION_CREDENTIALS=
